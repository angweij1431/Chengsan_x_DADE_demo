# ===========================================================================
# BOOTH PROTOTYPE (booth_app.py)  -- start here
# ===========================================================================
#
# The booth runs entirely on MiniMax. There is no Google dependency.

PORT=5000

# --- MiniMax: powers ALL THREE stations ------------------------------------
# !! PAID !! MiniMax has no free tier. Every generation costs money.
# Get a key at https://platform.minimax.io/user-center/basic-information
#
# ✏️ YOU MUST ENTER THIS. Nothing works without it.
MINIMAX_API_KEY=your_minimax_api_key

# Region. api.minimax.io is the INTERNATIONAL platform (use this unless you
# signed up on the mainland China platform, which is a different host AND a
# separate account/key namespace - keys are NOT interchangeable between them).
# Mainland China: https://api.minimaxi.com
MINIMAX_API_BASE=https://api.minimax.io

# --- Stations 2 & 3: image editing / scene compositing ---------------------
# image-01 is MiniMax's image model.
MINIMAX_IMAGE_MODEL=image-01

# Vision model, used to READ the visitor's second photo (their reference look
# or their environment shot) and describe it in words. Must be an M3-generation
# model - the M2.x series is text-only and will silently ignore images.
MINIMAX_TEXT_MODEL=MiniMax-M3

# image-01's prompt budget. Prompts longer than this are trimmed before sending.
MINIMAX_PROMPT_LIMIT=1500

# --- Station 1: dance video ------------------------------------------------
# minimax   = MiniMax Hailuo image-to-video (DEFAULT). Photo becomes the first
#             frame, a text prompt describes the dance.
# mock      = local render, no API key, no cost. Use for testing, and as the
#             fallback if the paid provider fails mid-event.
# replicate = Wan 2.2 Animate. The only provider that copies a specific
#             choreography frame-by-frame. Separate account and token.
DANCE_PROVIDER=minimax

# Hailuo model. MiniMax-Hailuo-2.3-Fast is cheaper and quicker; MiniMax-Hailuo-02
# is the cheapest way to get a real video (512P/6s); I2V-01-live is tuned for
# stylised/animated stills.
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02

# !! Resolution and duration are NOT independent, and what is valid depends on
# !! the model above. The booth checks this at startup and refuses a bad pair
# !! rather than letting MiniMax reject a request you already queued.
#
#   MiniMax-Hailuo-2.3       768P: 6 or 10s   1080P: 6s        (no 512P)
#   MiniMax-Hailuo-2.3-Fast  768P: 6 or 10s   1080P: 6s        (no 512P)
#   MiniMax-Hailuo-02        512P: 6 or 10s   768P: 6 or 10s   1080P: 6s
#   I2V-01 / -Director / -live                720P: 6s only
#
# Lower and shorter is cheaper. See "Part 3" in README.md for the price table.
MINIMAX_DURATION=6
MINIMAX_RESOLUTION=512P

# How long to wait for a render before giving up, in seconds.
# Typical MiniMax render is 1-5 minutes.
MINIMAX_TIMEOUT=600

# --- Rate limits -----------------------------------------------------------
# Per-session caps stop one visitor hogging the booth.
# Daily caps protect the budget: with MiniMax behind every station, these are
# the real safety net. SET THEM DELIBERATELY.
LIMIT_DANCE_TEMPLATE_SESSION=3
LIMIT_DANCE_TEMPLATE_DAILY=300
LIMIT_DANCE_CUSTOM_SESSION=1
LIMIT_DANCE_CUSTOM_DAILY=100
LIMIT_EDIT_SESSION=5
LIMIT_EDIT_DAILY=400
LIMIT_SCENE_SESSION=5
LIMIT_SCENE_DAILY=400

# Set to true ONLY while developing.
DISABLE_RATE_LIMITS=false

# Longest edge for uploaded photos before they are sent to the model.
MAX_INPUT_DIM=1536

# Override the host baked into QR codes. Leave blank to auto-detect the LAN IP.
# ✏️ Set this if the booth is behind a tunnel (ngrok/Cloudflare) or a fixed
# domain, or if the venue WiFi isolates clients from each other.
BOOTH_PUBLIC_HOST=

# ===========================================================================
# LEGACY DEMO (app.py / app2.py) -- the original fake-AI dance wizard
# ===========================================================================
#
# The booth does NOT use anything below. These belong to the original demo
# files, which are kept but unwired.
#
# NOTE: DB_TYPE=firestore and the FIREBASE_* values below are Google Cloud.
# The booth no longer touches Google at all, so if you are not reviving the
# legacy demo you can delete this whole section, delete serviceAccountKey.json,
# and revoke that service account in the Firebase console.

FLASK_ENV=development
DB_TYPE=postgres
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ✏️ Postgres connection, used when DB_TYPE=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dance_db
DB_USER=postgres
DB_PASSWORD=your_password

# ✏️ Cloudinary video hosting for the legacy app.py.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ✏️ Generic AI endpoint used by the legacy generate_video.py.
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.replicate.com/v1/predictions

# ✏️ app2.py (Streamlit void-deck inpainting) uses a Hugging Face token.
API_TOKEN=your_huggingface_token
