# ===========================================================================
# BOOTH PROTOTYPE (booth_app.py)  -- start here
# ===========================================================================

PORT=5000

# --- Gemini: powers Station 2 (edit) and Station 3 (scene). FREE TIER. ------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Leave blank to auto-detect the best image model your key can reach.
# Run `python -m booth.gemini_image` to see the list.
GEMINI_IMAGE_MODEL=

# Only gemini-2.5-flash-image has a free tier (~500 images/day), and it
# RETIRES 2026-10-16. gemini-3.1-flash-image and gemini-3-pro-image are
# paid-only. Leave true while running on free credits; set false once
# billing is enabled to get the newer, better models.
GEMINI_PREFER_FREE_TIER=true

# NOTE: this has NO EFFECT on the plain GEMINI_API_KEY path used here.
# person_generation is a Vertex AI-only setting; the SDK rejects it outright on
# the Developer API, so the booth only sends it if you switch to Vertex. Left
# here for that case. On an API key, family photos are handled by the model's
# default behaviour and there is no knob to loosen it.
GEMINI_ALLOW_MINORS=true

# --- Station 1: dance video ------------------------------------------------
# !! PAID !! NO Gemini video model has a free tier. Station 1 costs money
# whichever provider you pick, except `mock`.
#
# gemini_omni = Gemini Omni 1.1 Flash (DEFAULT). First-party, handles templates
#               AND visitor clips (as a ~3s motion/style reference). ~$0.10/sec
#               at 720p. Needs billing enabled on GEMINI_API_KEY's project.
# mock        = local render, no API key, no cost. Use for testing, and as the
#               fallback if the paid provider fails mid-event.
# replicate   = Wan 2.2 Animate. Copies a specific choreography frame-by-frame,
#               more faithfully than Omni and cheaper (~$0.20-0.40 per 5s).
# veo         = Google Veo. Templates only, no driving clip. Superseded by omni.
DANCE_PROVIDER=gemini_omni

# Used when DANCE_PROVIDER=gemini_omni. Runs on GEMINI_API_KEY above.
OMNI_MODEL=gemini-omni-1.1-flash

# Duration must be a whole number from 3 to 10 (Omni's hard limit).
# Cost is per second, so this number is your per-visitor price.
OMNI_DURATION=6

# One of: 360p, 720p, 1080p, 4k. 360p is ~1/3 the cost of 720p and much
# faster - the sensible booth setting once you have seen it working.
OMNI_RESOLUTION=720p

# 9:16 portrait suits phones; 16:9 suits a big screen.
OMNI_ASPECT_RATIO=9:16

# HTTP timeout in seconds for one generation. Raise for 1080p/4k.
OMNI_TIMEOUT=600

# Visitor clips are trimmed to this many seconds before upload. Omni's guidance
# is ~3s for a motion reference; longer clips just upload slower.
OMNI_REFERENCE_SECONDS=3

# Needed only when DANCE_PROVIDER=replicate. https://replicate.com/account
REPLICATE_API_TOKEN=
REPLICATE_DANCE_MODEL=wan-video/wan-2.2-animate-animation

# Needed only when DANCE_PROVIDER=veo. Billed per second, no free tier.
VEO_MODEL=veo-3.1-fast-generate-preview

# --- Rate limits -----------------------------------------------------------
# Per-session caps stop one visitor hogging the booth.
# Daily caps protect the budget: they are the real safety net when a paid
# video API is behind the button.
LIMIT_DANCE_TEMPLATE_SESSION=3
LIMIT_DANCE_TEMPLATE_DAILY=300
LIMIT_DANCE_CUSTOM_SESSION=1
LIMIT_DANCE_CUSTOM_DAILY=100
LIMIT_EDIT_SESSION=5
LIMIT_EDIT_DAILY=400
LIMIT_SCENE_SESSION=5
LIMIT_SCENE_DAILY=400

# Set to true ONLY while developing.
DISABLE_RATE_LIMITS=false

# Longest edge for uploaded photos before they are sent to the model.
MAX_INPUT_DIM=1536

# Override the host baked into QR codes. Leave blank to auto-detect the LAN IP.
# Set this if the booth is behind a tunnel (ngrok/Cloudflare) or a fixed domain.
BOOTH_PUBLIC_HOST=

# ===========================================================================
# LEGACY DEMO (app.py) -- the original fake-AI dance wizard
# ===========================================================================

FLASK_ENV=development
DB_TYPE=firestore
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dance_db
DB_USER=postgres
DB_PASSWORD=your_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.replicate.com/v1/predictions

# app2.py (Streamlit void-deck inpainting) uses a Hugging Face token.
API_TOKEN=your_huggingface_token
