# Application Configuration
PORT=5000
FLASK_ENV=development

# Database Backend Configuration (options: firestore, postgres)
DB_TYPE=firestore

# Firebase Firestore Configuration
# Path to your Firebase service account JSON key file (e.g., ./serviceAccountKey.json)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# PostgreSQL Configuration (Optional fallback if DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dance_db
DB_USER=postgres
DB_PASSWORD=your_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Body-Swapping Service Endpoint (Placeholder for Replicate / Runway / DACE / AnimateDiff)
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.replicate.com/v1/predictions
